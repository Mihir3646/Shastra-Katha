# Vercel AI Gateway — one key for Jev, Claude, Gemini and the rest.
# Get it at https://vercel.com/dashboard -> AI Gateway -> API Keys
# Copy this file to .env.local and paste your key there. .env.local is gitignored.
AI_GATEWAY_API_KEY=

# Alternative: call TypeSafe directly instead of through the gateway.
# TYPESAFE_API_KEY=

# Hugging Face read token — only needed for gated models (AI4Bharat Hindi TTS)
HF_TOKEN=
